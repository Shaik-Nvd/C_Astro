---
const { delay = 0 } = Astro.props;
---

<div class="fade-in" style={`animation-delay: ${delay}ms;`}>
  <slot />
</div>

<style>
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeIn 0.8s ease-out forwards;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>