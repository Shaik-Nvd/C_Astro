---
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" }
];
---

<style>
  nav {
    display: flex;
    justify-content: center;
    background-color: #222;
    padding: 15px;
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 20px;
  }
  li {
    display: inline;
  }
  a {
    text-decoration: none;
    color: #fff;
    font-size: 18px;
    padding: 10px 15px;
    border-radius: 5px;
    transition: background 0.3s;
  }
  a:hover {
    background-color: #ff9800;
  }
</style>

<nav>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href}>{link.label}</a>
      </li>
    ))}
  </ul>
</nav>
